{% liquid
  assign settings = section.settings
  assign title = settings.title
  assign description = settings.description
  assign button_text = settings.button_text
  assign button_url = settings.button_url
%}

<div class="py-10 lg:py-20 bg-[#f4f3f1]">
  <div class="site-container">
    <header class="grid content-start lg:flex lg:justify-between gap-2 mb-6 lg:mb-8">
      <div>
        <h2 class="text-[1.75rem] lg:text-4xl font-heading font-bold lg:font-extrabold text-center lg:text-left">{{ title }}</h2>
        {% unless description == blank %}
          <p class="text-lg mt-2">{{ description }}</p>
        {% endunless %}
      </div>
      {% unless button_text == blank or button_url == blank %}
        <nav class="hidden lg:flex" aria-label="Product navigation">
          <a href="{{ button_url }}" class="flex justify-center text-sm items-center font-poppins-md gap-2 text-[#5C553A] lg:hover:opacity-60 transition-all duration-300">
            <span>{{ button_text }}</span>
            {% render 'icon-arrow-right' %}
          </a>
        </nav>
      {% endunless %}
    </header>

    <featured-products-mobile class="lg:hidden">
      <div class="grid content-start gap-[0.625rem] gap-y-7 grid-cols-2">
        {% for block in section.blocks limit: 4 %}
          {% if block.type == "product" %}
            {% render 'product-item', product: block.settings.product %}
          {% endif %}
        {% endfor %}
      </div>
      {% if section.blocks.size > 4 %}
        <div
          data-fp-extra
          style="height: 0px; overflow: hidden; transition: height 450ms ease; will-change: height;">
          <div class="grid content-start gap-[0.625rem] gap-y-7 grid-cols-2 pt-7">
            {% for block in section.blocks offset: 4 %}
              {% if block.type == "product" %}
                {% render 'product-item', product: block.settings.product %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
        <button
          type="button"
          data-fp-toggle
          aria-expanded="false"
          class="w-full h-14 p-1 bg-[#1C1D1D] text-white rounded-full overflow-hidden mt-6">
          <span class="rounded-full w-full h-full flex items-center justify-center relative z-10 font-poppins-md" data-fp-toggle-label>Show More</span>
        </button>
      {% endif %}
    </featured-products-mobile>
  </div>

  <products-carousel class="hidden lg:block" role="region" aria-label="{{ title }}">
    <div data-scroll-container class="products-carousel-scroll flex gap-6">
      {% for block in section.blocks %}
        {% if block.type == "product" %}
          <div style="flex-shrink:0;width:calc((min(100vw,1440px) - 10.5rem) / 3.8)">
            {% render 'product-item', product: block.settings.product %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="site-container mt-8">
      <div data-carousel-track class="relative h-1 hover:h-[6px] w-full bg-[#d7d3cf] rounded-full overflow-hidden cursor-pointer select-none transition-all duration-300">
        <div data-carousel-thumb class="absolute top-0 left-0 h-full bg-[#1C1D1D] rounded-full transition-all duration-300"></div>
      </div>
    </div>
  </products-carousel>
</div>

{% schema %}
  {
    "name": "Featured Products",
    "tag": "section",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title"
      },
      {
        "type": "text",
        "id": "description",
        "label": "Description"
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Button text",
        "info": "Text displayed on the section button. Both button text and URL are required."
      },
      {
        "type": "url",
        "id": "button_url",
        "label": "Button URL",
        "info": "URL the button links to"
      }
    ],
    "blocks": [
      {
        "type": "product",
        "name": "Product",
        "settings": [
          {
            "type": "product",
            "id": "product",
            "label": "Product"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Featured Products",
        "settings": {
          "title": "Best Sellers",
          "button_text": "Shop All Best Sellers",
          "button_url": "shopify://collections"
        },
        "blocks": [
          { "type": "product", "settings": { "product": "bronze-easy-entry" } },
          { "type": "product", "settings": { "product": "silver-easy-entry" } },
          { "type": "product", "settings": { "product": "gold-easy-entry" } },
          { "type": "product", "settings": { "product": "platinum-easy-entry" } },
          { "type": "product", "settings": { "product": "bronze-easy-entry" } },
          { "type": "product", "settings": { "product": "silver-easy-entry" } },
          { "type": "product", "settings": { "product": "gold-easy-entry" } },
          { "type": "product", "settings": { "product": "platinum-easy-entry" } },
          { "type": "product", "settings": { "product": "bronze-easy-entry" } },
          { "type": "product", "settings": { "product": "silver-easy-entry" } }
        ]
      }
    ]
  }
{% endschema %}
